    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">OpenAPI (a.k.a. Swagger) Support for Otobo. </Description>
    <Filelist>
        <File Permission="660" Location="Custom/Kernel/Modules/AdminGenericInterfaceWebservice.pm" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/AdminGenericInterfaceWebservice.tt" />

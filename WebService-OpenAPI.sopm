<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="1.0">
    <Name>WebService-OpenAPI</Name>
    <Version>0.0.0</Version>
    <Framework>11.0.x</Framework>
    <Vendor>Rother OSS GmbH</Vendor>
    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">OpenAPI (a.k.a. Swagger) Support for Otobo. </Description>
    <Filelist>
        <File Permission="660" Location="Kernel/Config/Files/XML/WebServiceOpenAPI.xml" />
        <File Permission="660" Location="Kernel/Modules/AdminSwagger.pm" />
        <File Permission="660" Location="Kernel/Modules/Swagger.pm" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/favicon-16x16.png" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/favicon-32x32.png" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/index.css" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/index.html" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/oauth2-redirect.html" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-initializer.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-bundle.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-bundle.js.map" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-es-bundle-core.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-es-bundle-core.js.map" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-es-bundle.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-es-bundle.js.map" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-standalone-preset.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui-standalone-preset.js.map" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui.css" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui.css.map" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/swagger-ui.js.map" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/NOTICE" />
        <File Permission="660" Location="var/httpd/htdocs/js/thirdparty/swagger/LICENSE" />
        <File Permission="660" Location="var/webservices/metadata/components.yml" />
        <File Permission="660" Location="var/webservices/metadata/FAQDefaultProvider.yml" />
        <File Permission="660" Location="var/webservices/metadata/CMDBDefaultProvider.yml" />
        <File Permission="660" Location="var/webservices/metadata/SessionDefaultProvider.yml" />
        <File Permission="660" Location="var/webservices/metadata/TicketDefaultProvider.yml" />
        <File Permission="660" Location="var/webservices/examples/Session.yml" />
        <File Permission="660" Location="var/webservices/examples/Ticket.yml" />
        <File Permission="660" Location="var/webservices/examples/FAQ.yml" />
        <File Permission="660" Location="var/webservices/examples/CMDB.yml" />
    </Filelist>
    <IntroInstall Type="post" Lang="en" Title="Thank you!"><![CDATA[
        To use the Otobo OpenAPI spec and the builtin Swagger UI, it is necessary to configure at least one Provider Webservice in Otobo.
        <br>
        Go to Admin UI -> <a href="/otobo/index.pl?Action=AdminGenericInterfaceWebservice">Webservices</a> and click 'Add New'. Next either configure a Provider Webservice on your own or choose one or more of the provided example Provider Webservices.
        <br>
        The example Provider Webservices that come with this module are 'Session' and 'Ticket'.
        <br>
        Once you have at least one Provider Webservice configured, you can use the autogenerated Otobo OpenAPI spec via the builtin Swagger UI.
        Open the Swagger UI by navigating to Admin UI -> <a href="/otobo/index.pl?Action=AdminSwagger">OpenAPI (Swagger UI)</a>
        ]]>
    .</IntroInstall>
</otobo_package>
